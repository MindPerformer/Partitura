# .env.example — Partitura 生产环境配置模板
#
# 引入动机：design/05-OPERATIONS.md 要求安全的生产配置模板。
# 使用前必须复制为 .env 并替换所有标记为 <MUST_REPLACE> 的值。
# 禁止将 .env 提交到版本库。

# === PostgreSQL 配置（必填）===
# 引入动机：PostgreSQL 是业务真相源，必须配置安全凭据。
POSTGRES_USER=partitura
# <MUST_REPLACE> 生产环境必须替换为强密码（至少 32 字符随机字符串）
POSTGRES_PASSWORD=<MUST_REPLACE>
POSTGRES_DB=partitura
# 数据卷名称前缀，用于持久化
POSTGRES_DATA_VOLUME=partitura_pgdata

# === Server 数据库连接 ===
DB_HOST=postgres
DB_PORT=5432
DB_USER=partitura
# <MUST_REPLACE> 必须与 POSTGRES_PASSWORD 一致
DB_PASSWORD=<MUST_REPLACE>
DB_NAME=partitura
# Compose 内部网络使用 disable；生产环境应使用 require 或 verify-full
DB_SSLMODE=disable

# === Server 基础配置 ===
HTTP_ADDR=:8080
LOG_LEVEL=info
# 优雅关闭超时，必须大于 stop_grace_period
SHUTDOWN_TIMEOUT=45s
# <MUST_REPLACE> 对外服务的可信 public origin（不含路径），用于 device authorization verification_url。
# 例如 https://app.example.com。缺少或非法时 device start fail closed，禁止从请求 Host 推导。
PUBLIC_ORIGIN=<MUST_REPLACE>

# === 认证配置 ===
# 生产环境必须设为 true
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Session 有效期（秒），默认 86400（24h）
SESSION_DURATION=86400
DEVICE_ACCESS_TOKEN_DURATION=900
DEVICE_REFRESH_TOKEN_DURATION=2592000

# Argon2id 参数（默认值适用于大多数生产环境）
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# === Elasticsearch 配置 ===
ES_URL=http://elasticsearch:9200

# === 根加密密钥（基础设施密钥）===
# 引入动机：Provider API Key 使用 AES-256-GCM 加密后存储于 PostgreSQL。
# 部署方必须通过此环境变量提供 base64 编码的 32 字节密钥。
# 生成方式：openssl rand -base64 32
# 此密钥为基础设施密钥，不进入 Web 管理接口、审计详情或日志。
# 可为空——表示尚未配置，此时若数据库有 Provider 密文则 fail-fast 拒绝启动。
# 部署方必须将此密钥纳入安全备份方案；密钥丢失时旧 Provider 密文不可恢复。
# <MUST_REPLACE> 生产环境必须注入安全生成的 base64 编码 32 字节密钥
MASTER_ENCRYPTION_KEY=<MUST_REPLACE>

# === Provider 配置说明 ===
# Embedding 和 Reranker Provider 的配置（base_url, api_key, model, dimensions 等）
# 不再通过环境变量管理，而是由系统管理员通过 Web 管理页面配置：
#   1. 首次启动时通过 /bootstrap 页面创建第一个 system_admin 用户
#   2. 登录后通过 /admin/providers 页面配置 Embedding 和 Reranker Provider
#   3. Provider API Key 通过 AES-256-GCM 加密后存储于 PostgreSQL，绝不以明文存储
#   4. 保存后自动热更新搜索管线和健康检查，无需重启服务

# === Job Worker 配置 ===
# 生产环境建议启用 worker（单实例或指定实例启用）
JOB_WORKER_ENABLED=true
# 轮询间隔（秒）
JOB_WORKER_POLL_INTERVAL=5

# === Scheduler 配置 ===
# 启用周期性维护调度器（integrity repair/retry/cleanup/evaluation）
SCHEDULER_ENABLED=true
# 调度器轮询间隔（秒）
SCHEDULER_TICK_INTERVAL=60

# === 健康检查配置 ===
# /readyz 中 Embedding 和 Reranker 两个检查会发起真实推理请求（真实 embedding 调用 / 真实 rerank 推理），
# 因此使用独立超时；PG、ES、job 统计、active profile 等快检查仍固定使用 5s。
# 引入动机：provider 冷启动或模型推理耗时常常超过 5s，沿用快检查的 5s 会把"慢但可用"的 provider
# 误报为 degraded，并持续输出 context deadline exceeded（线上事故）。
# 单位秒，必须为正整数；非法值会导致服务启动 fail fast。未设置时默认 30。
HEALTH_PROVIDER_CHECK_TIMEOUT_SECONDS=30

# === Web 前端配置 ===
# Nuxt 运行时 API 基础路径（浏览器到 web 容器的相对路径）
NUXT_PUBLIC_API_BASE=/api
# Nginx 反向代理 upstream（web 容器内部访问 server 容器）
# 格式为 host:port，与 nginx upstream server 指令匹配
SERVER_UPSTREAM=server:8080
