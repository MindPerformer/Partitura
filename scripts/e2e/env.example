# scripts/e2e/env.example — Partitura 本地 E2E 测试环境模板（非敏感）
#
# 用法：
#   1) 复制为仓库外的 ~/.config/partitura/e2e.env（推荐）或 scripts/e2e/.secrets.env（仓库内，已 gitignore）
#   2) 填写所有 <REPLACE_ME> 字段（尤其 ADMIN_PASSWORD 与 PROVIDER_API_KEY）
#   3) bash scripts/e2e/run-e2e.sh
#
# 安全约束：本文件只提交模板（占位符）。真实密钥绝不允许写入版本控制。

# --- 被测服务对外地址 ---
# 浏览器/curl 访问 web（Nginx）的地址。默认 127.0.0.1:8080（WEB_PORT 映射到宿主 8080，避开 80 特权端口）。
E2E_WEB_BASE_URL=http://127.0.0.1:8080

# --- 首个 system_admin（POST /api/bootstrap 创建；重复运行需保持一致以便复用）---
E2E_ADMIN_USERNAME=testadmin
E2E_ADMIN_EMAIL=testadmin@example.com
E2E_ADMIN_PASSWORD=<REPLACE_ME>

# --- 测试用 Provider（https://ai.gitee.com/v1 等 OpenAI-compatible 服务）---
E2E_PROVIDER_BASE_URL=https://ai.gitee.com/v1
E2E_PROVIDER_API_KEY=<REPLACE_ME>
E2E_EMBEDDING_MODEL=Qwen3-Embedding-8B
E2E_EMBEDDING_DIMENSIONS=1024
E2E_RERANKER_MODEL=Qwen3-Reranker-8B
E2E_EMBEDDING_TIMEOUT=60
E2E_RERANKER_TIMEOUT=30

# --- compose 相关 ---
# web 对外映射端口（避免占用宿主 80）
E2E_COMPOSE_WEB_PORT=8080
# PUBLIC_ORIGIN（server device authorization 要求可信 origin）
E2E_PUBLIC_ORIGIN=http://127.0.0.1:8080

# --- 环境探测覆盖 ---
# 仓库根目录（Linux/WSL 内为绝对路径，如 /mnt/d/Partitura）。留空自动探测。
E2E_PROJECT_ROOT=
# 当从 Windows GitBash 调用且检测到 WSL 时，使用哪个发行版执行 docker/测试
E2E_WSL_DISTRO=Debian
